# Tangmas v2 Environment Variables Example
DATA_API_URL=https://syncdata.kpungawi.com
SYNCDATA_API_URL=https://syncdata.kpungawi.com

NEXT_PUBLIC_APP_NAME=Tanggapan Masyarakat Online KPU Kabupaten Ngawi
NEXT_PUBLIC_WHATSAPP_NUMBER=62859106510645

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=tangmas
DB_PASSWORD=your_database_password
DB_NAME=tangmas

# Base URL Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (dari Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback/

# Secret Key untuk Enkripsi Cookie Sesi Admin (HMAC SHA-256)
AUTH_SESSION_SECRET=generate_a_random_32_bytes_hex_string

# Mail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=helpdeskdaftarpemilihkpungawi@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Tangmas KPU Kabupaten Ngawi <helpdeskdaftarpemilihkpungawi@gmail.com>"

# Admin Notification Target Email
ADMIN_NOTIFICATION_EMAIL=datinkpungawi@gmail.com
